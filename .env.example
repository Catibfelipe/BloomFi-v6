# Copie para ".env" só para testar no seu computador (npm run local ou "Testar no Mac.command").
# No Netlify, cadastre estas mesmas variáveis em: Site configuration → Environment variables.
# Nunca envie o .env para o GitHub nem para ninguém.

# 1) Gere com ferramentas/gerar-chaves.html (ou: npm run chaves)
#    NUNCA troque o APP_SECRET depois do lançamento: ele protege as contas.
APP_SECRET=
LICENSE_PRIVATE_JWK=
# Notificações (lembretes de contas e alertas de gastos)
VAPID_PRIVATE_JWK=

# 2) E-mail — OBRIGATÓRIO no site (códigos de confirmação e avisos de segurança). resend.com, plano grátis.
#    Verifique o seu domínio no Resend; sem isso ele só entrega para o e-mail da própria conta Resend.
RESEND_API_KEY=
EMAIL_FROM=BloomFi <nao-responda@seudominio.com.br>

# 3) Endereço principal do site, sem barra no fim (ex.: https://bloomfi.com.br).
#    O servidor só aceita chamadas vindas dele. Deixe vazio para testar no computador.
APP_ORIGIN=

# 4) Stripe (dashboard.stripe.com → Developers → API keys).
#    sk_test_... para testar (cartão 4242 4242 4242 4242); sk_live_... no site oficial (cobra de verdade).
#    Também aceita chave restrita (rk_test_... / rk_live_...) com permissão Write em Customers, Subscriptions,
#    Checkout Sessions e Customer portal.
STRIPE_SECRET_KEY=
# Planos, pelo número de bancos conectados (os padrões já estão no servidor; preencha só para mudar):
#   Essencial R$ 14,90 (sem bancos) · Plus R$ 24,90 (até 3 bancos) · Premium R$ 34,90 (até 6 bancos)
PLAN_ESSENCIAL_CENTS=1490
PLAN_PLUS_CENTS=2490
PLAN_PREMIUM_CENTS=3490
PLAN_PLUS_BANKS=3
PLAN_PREMIUM_BANKS=6
# Opcional: IDs de preços criados no Stripe (price_...). Sem eles, o checkout usa os valores acima.
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PREMIUM=
PRICE_CURRENCY=brl
TRIAL_DAYS=7

# 5) Open Finance — Pluggy (dashboard.pluggy.ai → Applications)
#    Sem estas duas, o app avisa que a conexão com bancos ainda não está disponível (nada de banco de mentira).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# false no site oficial. true só para testar: mostra também o banco fictício "Pluggy Bank".
PLUGGY_SANDBOX=false

# 6) Opcional: e-mails com acesso gratuito (família/amigos), separados por vírgula
FREE_ACCESS_EMAILS=

# 7) Opcional: atalho pronto do iPhone (link do iCloud, veja o Passo 7 do LANCAMENTO.md)
#    Formato: https://www.icloud.com/shortcuts/...
IOS_SHORTCUT_URL=

# 8) Contato de suporte mostrado no app, no site e nos Termos/Privacidade
SUPPORT_EMAIL=
# WhatsApp (opcional): só números, com 55 e o DDD (ex.: 5511999998888)
SUPPORT_WHATSAPP=

# 9) Quem oferece o BloomFi (aparece nos Termos de Uso e na Política de Privacidade)
#    Nome completo ou razão social, CPF ou CNPJ e endereço (rua, número, bairro, cidade - UF, CEP). Também aparecem
#    no rodapé do site, como pede a lei do comércio eletrônico. Enquanto faltar, as páginas mostram os campos em destaque.
LEGAL_NAME=
LEGAL_ID=
LEGAL_ADDRESS=
# Opcional: encarregado de dados (LGPD). Sem eles, valem LEGAL_NAME e SUPPORT_EMAIL.
DPO_NAME=
DPO_EMAIL=

# 10) Wally com IA: roda no aparelho de cada pessoa (baixada no próprio app). Não precisa de chave nem de configuração.

# 11) Família e casal: pessoas por espaço compartilhado (cada uma com o seu login e o seu plano)
SPACE_MAX_MEMBERS=5
